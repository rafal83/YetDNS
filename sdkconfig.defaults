CONFIG_IDF_TARGET="esp32s3"
# The only supported board: ESP32-S3 N16R8 (16 MiB quad flash, 8 MiB octal PSRAM).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Upstream lookups open one UDP socket each: leave room for every worker plus the listeners, HTTP server and TLS.
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_MAX_UDP_PCBS=24
# Datagrams queued on a socket before lwIP drops them silently (6 by default): the DNS listener sees bursts.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# TLS buffers (DoH, list downloads, OTA) go to PSRAM; internal RAM is spent on upstream workers instead.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# Over-the-air updates: a new image must confirm itself or the bootloader reverts to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
